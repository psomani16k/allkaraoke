# Copy to allkaraoke.env (next to docker-compose.yml) and fill in. Never commit the copy.

# Password for the admin panel (/admin). Unset = admin panel locked.
ADMIN_PANEL_PASSWORD=
# Token for the unverified-songs admin API used by the import scripts
UNVERIFIED_SONGS_ADMIN_TOKEN=

# Ports. If you change them, update your firewall and reverse proxy to match.
# PORT=3010
# FAKE_SFU_UDP_PORTS=40000-40199
# FAKE_SFU_PORT=3480  # localhost only, no need to open it

# Optional: use Cloudflare Realtime instead of the built-in stand-in SFU. Needed for online mode with
# players outside your network; then the UDP range above is not used.
# REALTIME_APP_ID=
# REALTIME_APP_TOKEN=
# TURN/STUN for clients behind strict NATs. Only used together with Cloudflare Realtime.
# ONLINE_TURN_URLS=turn:turn.example.com:3478?transport=udp
# ONLINE_TURN_USERNAME=
# ONLINE_TURN_CREDENTIAL=
# ONLINE_STUN_URLS=stun:stun.example.com:3478
